generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  idUser      Int     @id @default(autoincrement()) @map("id_user")
  nomeUsuario String? @map("nome_usuario") @db.VarChar(100)
  cpfCnpj     String? @map("cpf_cnpj") @db.VarChar(25)
  cep         String? @map("cep") @db.VarChar(12)
  telefone1   String? @map("telefone1") @db.VarChar(25)
  email       String? @map("email") @db.VarChar(100)
  senha       String? // maps to TEXT
  tipo        String? @map("tipo") @db.VarChar(50)
  status      String? @map("status") @db.VarChar(15)

  @@map("usuarios")
}

model Noticia {
  idNoticia Int      @id @default(autoincrement()) @map("id_noticia")
  titulo    String?  @map("titulo") @db.VarChar(150)
  resumo    String   @map("resumo") // TEXT NOT NULL
  imagem    String?  @map("imagem")
  banner    String?  @map("banner")
  conteudo  String?  @map("conteudo")
  link      String?  @map("link")
  categoria String   @default("diaria") @db.VarChar(20)
  data      DateTime @default(dbgenerated("CURRENT_DATE")) @map("data") @db.Date

  @@map("noticias")
}

model Mapa {
  id        Int     @id @default(autoincrement())
  embedUrl  String? @map("embed_url")
  endereco  String? @map("endereco") @db.VarChar(200)
  latitude  Float?
  longitude Float?

  @@map("mapa")
}
